# Copy to web/.env and adjust. Placeholders only: never commit real secrets.

# SpacetimeDB (keep it bound to localhost; browsers reach it through the gateway)
SPACETIME_URL=http://127.0.0.1:3000
SPACETIME_DB=kaykit-arena
# Nickname of the server in `spacetime server list`, used for publish/call
SPACETIME_SERVER=local
# Optional custom start command, e.g. a standalone binary with explicit keys:
# SPACETIME_START_CMD="spacetimedb-standalone start --listen-addr 127.0.0.1:3000 --data-dir /srv/stdb --jwt-pub-key-path /srv/stdb/id_ecdsa.pub --jwt-priv-key-path /srv/stdb/id_ecdsa"

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Account database (SQLite) directory and the gateway's SpacetimeDB token (created on first start, chmod 600)
GATEWAY_DATA_DIR=../.data
GATEWAY_TOKEN_FILE=../.secrets/gateway-token
# Built client to serve; set to empty to disable static hosting
GATEWAY_STATIC_DIR=../client/dist
# Extra origins allowed to call /api (comma separated). Same-origin is always allowed.
ALLOWED_ORIGINS=
# Set to 1 when the gateway is only reachable through a proxy or tunnel (Caddy, nginx,
# `npm run tunnel`): rate limits then use CF-Connecting-IP / the proxy-added X-Forwarded-For entry.
TRUST_PROXY=0
# Login/register attempts per IP per minute
AUTH_RATE_LIMIT=20
